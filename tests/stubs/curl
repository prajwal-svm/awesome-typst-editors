#!/usr/bin/env bash
# Test stand-in for curl. Serves Codeberg API fixtures, and the counter CSV from
# STUB_COUNTER; fails like curl -f otherwise. Honours -o.
set -uo pipefail
fixtures="$(cd "$(dirname "$0")/.." && pwd)/fixtures/api"

if [ -n "${STUB_FAIL_ON:-}" ] && [[ "$*" == *"$STUB_FAIL_ON"* ]]; then
  echo "stub curl: simulated failure for: $*" >&2
  exit 22
fi
url="" out=""
while [ $# -gt 0 ]; do
  case "$1" in
    -o) out=$2; shift ;;
    https://*) url=$1 ;;
  esac
  shift
done
case "$url" in
  https://codeberg.org/api/v1/repos/*)
    path=${url#https://codeberg.org/api/v1/repos/}
    file="$fixtures/codeberg_${path//\//_}.json"
    [ -f "$file" ] || { echo "stub curl: no fixture for $url" >&2; exit 22; }
    ;;
  https://raw.githubusercontent.com/sermuns/days-since-last-typst-editor/main/data.csv)
    file=${STUB_COUNTER:?STUB_COUNTER is not set}
    ;;
  *)
    echo "stub curl: unsupported url: $url" >&2
    exit 22
    ;;
esac
if [ -n "$out" ]; then cp "$file" "$out"; else cat "$file"; fi
